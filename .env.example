# Configurações do servidor
PORT=3000
SESSION_SECRET=troque-este-segredo-em-producao

# Banco de dados PostgreSQL (opcional). Se não for preenchido, o site usa arquivos JSON
# locais em server/data (não recomendado para produção, pois não é persistente no Render).
DATABASE_URL=

# Login do painel administrativo
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# PagSeguro (Checkout Pro) - preencha com suas credenciais reais para habilitar pagamento online
PAGSEGURO_EMAIL=
PAGSEGURO_TOKEN=
PAGSEGURO_SANDBOX=true

# Notificações no celular (Web Push). Opcional: se as chaves ficarem em branco, o servidor gera
# um par automaticamente e guarda no banco. VAPID_SUBJECT deve ser um e-mail (mailto:) ou site
# (https://) de contato da loja.
VAPID_SUBJECT=mailto:contato@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
