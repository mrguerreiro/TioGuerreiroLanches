# Configurações do servidor
PORT=3000
SESSION_SECRET=troque-este-segredo-em-producao

# Banco de dados (opcional): MongoDB Atlas (gratuito) ou PostgreSQL. Se os dois ficarem em branco, o site
# usa arquivos JSON locais em server/data (não recomendado para produção, pois não é persistente no Render).
# MONGODB_URI tem prioridade sobre DATABASE_URL. Ex.: mongodb+srv://usuario:senha@cluster.mongodb.net/tioguerreiro
MONGODB_URI=
DATABASE_URL=

# Login do painel administrativo
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# PagSeguro/PagBank (Checkout API) - preencha com o token da conta para habilitar pagamento online.
# Sem token, a opção "Pagar agora" abre uma página de simulação.
PAGSEGURO_TOKEN=
PAGSEGURO_SANDBOX=true

# Endereço público do site (https), usado nos avisos de pagamento do PagBank e no retorno do cliente.
# Com domínio próprio, preencha (ex.: https://tioguerreirolanches.com.br): quem acessar pelo endereço do
# Render ou pelo "www" é redirecionado para ele. Deixe em branco para rodar localmente.
SITE_URL=

# Taxa de entrega por distância (OpenRouteService, grátis: https://openrouteservice.org/dev/#/signup).
# Sem a chave, vale a taxa fixa das Configurações do painel. Ver "Taxa de entrega por distância" no README.
ORS_API_KEY=

# Notificações no celular (Web Push). Opcional: se as chaves ficarem em branco, o servidor gera
# um par automaticamente e guarda no banco. VAPID_SUBJECT deve ser um e-mail (mailto:) ou site
# (https://) de contato da loja.
VAPID_SUBJECT=mailto:contato@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
